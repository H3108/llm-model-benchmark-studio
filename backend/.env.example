# ── Admin ──
ADMIN_TOKEN=

# ── OpenRouter ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# ── SiliconFlow ──
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Comma/newline-separated model IDs confirmed $0 input + output on SiliconFlow pricing page.
SILICONFLOW_FREE_MODELS=

# ── OpenCode (Zen) ──
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Comma/newline-separated operator-confirmed free model IDs.
OPENCODE_FREE_MODELS=

# ── Tencent Cloud Hunyuan ──
# API key: https://console.cloud.tencent.com/hunyuan/api-key
TENCENTCLOUD_API_KEY=
TENCENTCLOUD_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# Comma/newline-separated operator-confirmed models with free quota.
TENCENTCLOUD_FREE_MODELS=

# ── NVIDIA NIM (build.nvidia.com) ──
# API key: https://build.nvidia.com  (nvapi-...)
# Free status is operator-confirmed only; list model IDs below.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FREE_MODELS=

# ── Google Gemini (AI Studio free tier) ──
# API key: https://aistudio.google.com/apikey
# Free status is operator-confirmed only; list model IDs below.
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_FREE_MODELS=

# ── Database ──
DATABASE_URL=sqlite:///./benchmark.db
REQUEST_TIMEOUT_SECONDS=60

# ── CORS (comma-separated origins; for production add your domain) ──
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════
# 动态自定义 Provider（OpenAI 兼容）
# ═══════════════════════════════════════════════════════════════════════
# 新增一个 OpenAI 兼容的服务商只需：
# 1. 在 CUSTOM_PROVIDERS 里加上 provider ID（小写，逗号分隔）
# 2. 为它配置 {ID}_API_KEY / {ID}_BASE_URL / {ID}_FREE_MODELS
# 3. 可选：{ID}_LABEL（显示名）/ {ID}_COLOR（主题色）/ {ID}_INITIALS（头像缩写）
# 4. 重启后端
#
# 示例：月之暗面 + DeepSeek
# CUSTOM_PROVIDERS=moonshot,deepseek
#
# MOONSHOT_API_KEY=sk-xxx
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_FREE_MODELS=moonshot-v1-8k,moonshot-v1-32k
# MOONSHOT_LABEL=月之暗面
# MOONSHOT_COLOR=#6366f1
# MOONSHOT_INITIALS=MK
#
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FREE_MODELS=deepseek-chat
# DEEPSEEK_LABEL=深度求索

CUSTOM_PROVIDERS=
